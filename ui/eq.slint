import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Icon } from "icons.slint";
import { App } from "state.slint";
import { IconButton, VerticalFader, Chip, TextButton, ToggleSwitch, Cover } from "widgets.slint";

component ValueSlider inherits Rectangle {
    in property <string> label: "Value";
    in-out property <float> value: 0;
    in property <float> min: 0;
    in property <float> max: 1;
    in property <string> suffix: "";
    height: 46px;
    background: transparent;
    property <float> frac: Math.max(0, Math.min(1, (value - min) / Math.max(0.0001, max - min)));
    HorizontalLayout {
        padding-left: 2px; padding-right: 2px;
        spacing: 8px;
        VerticalLayout { width: 94px; spacing: 0px; alignment: center;
            Text { text: root.label; color: Theme.text; font-size: (12px * Theme.font-scale); font-weight: 600; overflow: elide; }
            Text { text: (Math.round(value * 100) / 100) + root.suffix; color: Theme.accent; font-size: (10px * Theme.font-scale); font-weight: 700; }
        }
        Rectangle {
            height: 22px; horizontal-stretch: 1; background: transparent;
            Rectangle { width: 100%; height: 3px; border-radius: 2px; background: Theme.surface-3; y: 9px; }
            Rectangle { width: parent.width * frac; height: 3px; border-radius: 2px; background: Theme.accent; y: 9px; }
            Rectangle { x: Math.max(0, parent.width * frac - 6px); y: 3px; width: 12px; height: 12px; border-radius: 6px; background: #ffffff; }
            TouchArea {
                width: 100%; height: 100%;
                clicked => { root.value = root.min + self.mouse-x / self.width * (root.max - root.min); root.changed(root.value); }
                moved => { if (self.pressed) { root.value = root.min + self.mouse-x / self.width * (root.max - root.min); root.changed(root.value); } }
            }
        }
    }
    callback changed(float);
}

component ToggleRow inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> icon: "eq";
    in property <bool> checked: false;
    height: 58px;
    background: Theme.surface-2;
    border-radius: 8px;
    HorizontalLayout {
        padding-left: 10px; padding-right: 10px; spacing: 10px;
        Rectangle { width: 32px; height: 32px; border-radius: 8px; background: Theme.surface-3;
            Icon { name: root.icon; tint: Theme.accent; size: 17px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
        VerticalLayout { horizontal-stretch: 1; spacing: 1px; alignment: center;
            Text { text: root.title; color: Theme.text; font-size: (13px * Theme.font-scale); font-weight: 650; }
            Text { text: root.subtitle; color: Theme.text-sub; font-size: (10px * Theme.font-scale); overflow: elide; }
        }
        ToggleSwitch { checked: root.checked; toggled(v) => { root.toggled(v); } }
    }
    callback toggled(bool);
}

component GroupLabel inherits Text {
    text: "";
    color: Theme.text-sub;
    font-size: (10px * Theme.font-scale);
    font-weight: 800;
    letter-spacing: 1.2px;
}

export component EqPage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.bg;
    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: 58px; background: Theme.bg;
            HorizontalLayout {
                padding-left: 8px; padding-right: 12px; spacing: 6px;
                IconButton { icon: "back"; tint: Theme.text; clicked => { App.navigate("settings"); } }
                Text { text: "Equalizer"; color: Theme.text; font-size: (21px * Theme.font-scale); font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                TextButton { text: "Reset"; compact: true; clicked => { App.apply-preset(0); } }
            }
        }

        ScrollView {
            min-width: 0px;
            width: 100%; height: 34px;
            HorizontalLayout {
                spacing: 8px;
                padding-left: 16px; padding-right: 16px;
                for tab in ["Equalizer", "Dynamics", "Visualizer", "Profiles"] : Chip {
                    text: tab;
                    selected: App.eq-tab == tab;
                    clicked => { App.eq-tab = tab; }
                }
            }
        }

        ScrollView {
            min-width: 0px;
            width: 100%; vertical-stretch: 1;
            VerticalLayout {
                padding-left: 16px; padding-right: 16px; padding-top: 10px; padding-bottom: 20px;
                spacing: 12px;

                Rectangle {
                    height: 48px; border-radius: 8px; background: Theme.surface-2;
                    HorizontalLayout {
                        padding: 5px; spacing: 10px;
                        Cover { art: App.current.art; accent: App.current.accent; width: 38px; height: 38px; radius: 4px; icon-size: 15px; }
                        VerticalLayout { horizontal-stretch: 1; spacing: 0px; alignment: center;
                            Text { text: App.current.title; color: Theme.text; font-size: (12px * Theme.font-scale); font-weight: 650; overflow: elide; }
                            Text { text: App.headphone-profile; color: Theme.accent; font-size: (10px * Theme.font-scale); overflow: elide; }
                        }
                        Icon { name: "headphones"; tint: Theme.text-sub; size: 18px; }
                    }
                }

                if App.eq-tab == "Equalizer" : VerticalLayout {
                    spacing: 10px;

                    GroupLabel { text: "HEADPHONE PROFILES"; }
                    ScrollView {
                        min-width: 0px;
                        width: 100%; height: 34px;
                        HorizontalLayout {
                            spacing: 7px;
                            for i in App.headphone-profiles.length : Chip {
                                text: App.headphone-profiles[i];
                                selected: App.headphone-index == i;
                                clicked => { App.apply-headphone(i); }
                            }
                        }
                    }
                    Text { text: "Community-style corrections for popular headphones. Select Flat for no correction."; color: Theme.text-faint; font-size: (9.5px * Theme.font-scale); wrap: word-wrap; }

                    GroupLabel { text: "PRESETS"; }
                    ScrollView {
                        min-width: 0px;
                        width: 100%; height: 34px;
                        HorizontalLayout {
                            spacing: 7px;
                            for i in App.eq-presets.length : Chip {
                                text: App.eq-presets[i];
                                selected: App.eq-preset == i;
                                clicked => { App.apply-preset(i); }
                            }
                        }
                    }

                    Rectangle {
                        height: 224px; border-radius: 8px; background: Theme.surface;
                        VerticalLayout {
                            padding: 8px;
                            HorizontalLayout {
                                alignment: space-around;
                                for i in 10 : VerticalLayout {
                                    alignment: start; spacing: 3px;
                                    Text { text: App.eq-gains[i] > 0 ? "+" + Math.round(App.eq-gains[i]) : Math.round(App.eq-gains[i]) + ""; color: Theme.text-sub; font-size: (8px * Theme.font-scale); horizontal-alignment: center; }
                                    VerticalFader { index: i; value: App.eq-gains[i]; }
                                    Text { text: ["31", "62", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"][i]; color: Theme.text-faint; font-size: (8px * Theme.font-scale); horizontal-alignment: center; }
                                }
                            }
                        }
                    }

                    GroupLabel { text: "SOUND SHAPING"; }
                    VerticalLayout { spacing: 2px;
                        ValueSlider { label: "Speed"; value: App.speed; min: 0.5; max: 2.0; suffix: "×"; changed(v) => { App.set-speed(v); } }
                        ValueSlider { label: "Pitch"; value: App.pitch; min: -12; max: 12; suffix: " st"; changed(v) => { App.set-pitch(v); } }
                        ValueSlider { label: "Bass boost"; value: App.bass-boost; min: 0; max: 12; suffix: " dB"; changed(v) => { App.set-bass(v); } }
                        ValueSlider { label: "Reverb"; value: App.reverb; min: 0; max: 1; suffix: ""; changed(v) => { App.set-reverb(v); } }
                    }
                    ToggleRow { title: "Volume normalizer"; subtitle: "Even out quiet and loud tracks"; icon: "volume"; checked: App.normalizer; toggled(v) => { App.toggle-normalizer(); } }
                }

                if App.eq-tab == "Dynamics" : VerticalLayout {
                    spacing: 10px;
                    GroupLabel { text: "COMPRESSOR"; }
                    ToggleRow { title: "Compressor"; subtitle: "Glue the mix with soft-knee gain control"; icon: "eq"; checked: App.compressor; toggled(v) => { App.set-compressor(v); } }
                    if App.compressor : VerticalLayout { spacing: 2px;
                        ValueSlider { label: "Threshold"; value: App.comp-threshold; min: -48; max: 0; suffix: " dB"; changed(v) => { App.set-comp-threshold(v); } }
                        ValueSlider { label: "Ratio"; value: App.comp-ratio; min: 1; max: 20; suffix: ":1"; changed(v) => { App.set-comp-ratio(v); } }
                        ValueSlider { label: "Attack"; value: App.comp-attack; min: 1; max: 200; suffix: " ms"; changed(v) => { App.set-comp-attack(v); } }
                        ValueSlider { label: "Release"; value: App.comp-release; min: 20; max: 1000; suffix: " ms"; changed(v) => { App.set-comp-release(v); } }
                        ValueSlider { label: "Makeup"; value: App.comp-makeup; min: 0; max: 24; suffix: " dB"; changed(v) => { App.set-comp-makeup(v); } }
                    }

                    GroupLabel { text: "MULTIBAND COMPRESSOR"; }
                    ToggleRow { title: "3-band MBC"; subtitle: "Independent low, mid and high control"; icon: "visualizer"; checked: App.mbc; toggled(v) => { App.set-mbc(v); } }
                    if App.mbc : VerticalLayout { spacing: 2px;
                        ValueSlider { label: "Low threshold"; value: App.mbc-low-threshold; min: -48; max: 0; suffix: " dB"; changed(v) => { App.set-mbc-band(0, v, App.mbc-low-ratio); } }
                        ValueSlider { label: "Low ratio"; value: App.mbc-low-ratio; min: 1; max: 20; suffix: ":1"; changed(v) => { App.set-mbc-band(0, App.mbc-low-threshold, v); } }
                        ValueSlider { label: "Mid threshold"; value: App.mbc-mid-threshold; min: -48; max: 0; suffix: " dB"; changed(v) => { App.set-mbc-band(1, v, App.mbc-mid-ratio); } }
                        ValueSlider { label: "Mid ratio"; value: App.mbc-mid-ratio; min: 1; max: 20; suffix: ":1"; changed(v) => { App.set-mbc-band(1, App.mbc-mid-threshold, v); } }
                        ValueSlider { label: "High threshold"; value: App.mbc-high-threshold; min: -48; max: 0; suffix: " dB"; changed(v) => { App.set-mbc-band(2, v, App.mbc-high-ratio); } }
                        ValueSlider { label: "High ratio"; value: App.mbc-high-ratio; min: 1; max: 20; suffix: ":1"; changed(v) => { App.set-mbc-band(2, App.mbc-high-threshold, v); } }
                    }

                    GroupLabel { text: "LIMITER"; }
                    ToggleRow { title: "Brickwall limiter"; subtitle: "Transparent clip protection"; icon: "volume"; checked: App.limiter; toggled(v) => { App.set-limiter(v); } }
                    if App.limiter : ValueSlider { label: "Ceiling"; value: App.limiter-ceiling; min: -24; max: 0; suffix: " dB"; changed(v) => { App.set-limiter-ceiling(v); } }

                    GroupLabel { text: "NOISE GATE"; }
                    ToggleRow { title: "Noise gate"; subtitle: "Silence hiss between quiet passages"; icon: "wave"; checked: App.gate; toggled(v) => { App.set-gate(v); } }
                    if App.gate : VerticalLayout { spacing: 2px;
                        ValueSlider { label: "Threshold"; value: App.gate-threshold; min: -80; max: -20; suffix: " dB"; changed(v) => { App.set-gate-threshold(v); } }
                        ValueSlider { label: "Release"; value: App.gate-release; min: 20; max: 500; suffix: " ms"; changed(v) => { App.set-gate-release(v); } }
                    }
                }

                if App.eq-tab == "Visualizer" : VerticalLayout {
                    spacing: 10px;
                    GroupLabel { text: "LIVE SPECTRUM"; }
                    Rectangle {
                        height: 250px; border-radius: 8px; background: Theme.surface; clip: true;
                        if App.spectrum.length >= 32 : Rectangle {
                            width: 100%; height: 100%;
                            if App.visualizer-mode == "Bars" : HorizontalLayout {
                                alignment: space-between;
                                padding: 12px;
                                for i in 32 : Rectangle {
                                    width: 4px; border-radius: 2px;
                                    height: Math.max(4px, App.spectrum[i] * 220px);
                                    background: @linear-gradient(0deg, Theme.accent 0%, Theme.accent-2 100%);
                                    y: parent.height - self.height;
                                }
                            }
                            if App.visualizer-mode == "Mirror" : HorizontalLayout {
                                alignment: space-between;
                                padding: 12px;
                                for i in 32 : Rectangle {
                                    width: 4px; border-radius: 2px;
                                    height: Math.max(4px, App.spectrum[i] * 220px);
                                    background: @linear-gradient(0deg, Theme.accent 0%, Theme.accent-2 100%);
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                            if App.visualizer-mode == "Pulse" : HorizontalLayout {
                                alignment: space-around;
                                padding: 16px;
                                for i in 24 : Rectangle {
                                    width: (6px + App.spectrum[i] * 30px);
                                    height: (6px + App.spectrum[i] * 30px);
                                    border-radius: self.width / 2;
                                    background: Theme.accent;
                                    opacity: 0.35 + App.spectrum[i] * 0.65;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                        if App.spectrum.length < 32 : VerticalLayout {
                            alignment: center;
                            Text { text: "Play a track to see the spectrum"; color: Theme.text-sub; font-size: (12px * Theme.font-scale); horizontal-alignment: center; }
                        }
                    }
                    HorizontalLayout { spacing: 8px;
                        for mode in ["Bars", "Mirror", "Pulse"] : Chip {
                            text: mode;
                            selected: App.visualizer-mode == mode;
                            clicked => { App.set-visualizer-mode(mode); }
                        }
                    }
                    ToggleRow { title: "Show in Now Playing"; subtitle: "Live bars under the progress bar"; icon: "visualizer"; checked: App.visualizer-on; toggled(v) => { App.visualizer-on = v; App.save-settings(); } }
                    Text { text: "The analyser uses the same 32-band Goertzel spectrum as the player. It runs on the audio thread and never blocks playback."; color: Theme.text-faint; font-size: (9.5px * Theme.font-scale); wrap: word-wrap; }
                }

                if App.eq-tab == "Profiles" : VerticalLayout {
                    spacing: 10px;
                    GroupLabel { text: "SAVED PROFILES"; }
                    HorizontalLayout { spacing: 8px;
                        ScrollView {
                            min-width: 0px;
                            width: 100%; height: 34px;
                            HorizontalLayout {
                                spacing: 7px;
                                for i in App.eq-profiles.length : Chip {
                                    text: App.eq-profiles[i];
                                    selected: false;
                                    clicked => { App.apply-profile(i); }
                                }
                                if App.eq-profiles.length == 0 : Text { text: "No saved profiles yet"; color: Theme.text-faint; font-size: (10.5px * Theme.font-scale); vertical-alignment: center; }
                            }
                        }
                        TextButton { text: "Save"; compact: true; clicked => { App.save-profile(); } }
                    }

                    GroupLabel { text: "SCENES"; }
                    GridLayout {
                        spacing: 8px;
                        for scene in [
                            { title: "Slowed + reverb", sub: "0.82× · hall", id: 6 },
                            { title: "Nightcore", sub: "1.28× · bright", id: 7 },
                            { title: "Bass worship", sub: "+9 dB low", id: 8 },
                            { title: "Clear sound", sub: "flat + vocal", id: 9 }
                        ] : Rectangle {
                            height: 62px; border-radius: 8px; background: Theme.surface-2;
                            VerticalLayout { padding: 10px; spacing: 2px;
                                Text { text: scene.title; color: Theme.text; font-size: (12px * Theme.font-scale); font-weight: 650; }
                                Text { text: scene.sub; color: Theme.text-sub; font-size: (10px * Theme.font-scale); }
                            }
                            TouchArea { width: 100%; height: 100%; clicked => { App.apply-preset(scene.id); } }
                        }
                    }

                    GroupLabel { text: "HEADPHONE PROFILES"; }
                    ScrollView {
                        min-width: 0px;
                        width: 100%; height: 34px;
                        HorizontalLayout {
                            spacing: 7px;
                            for i in App.headphone-profiles.length : Chip {
                                text: App.headphone-profiles[i];
                                selected: App.headphone-index == i;
                                clicked => { App.apply-headphone(i); }
                            }
                        }
                    }
                    Text { text: "Saving a profile stores the complete chain: EQ gains, bass, reverb, speed, pitch, compressor, limiter, gate and multiband settings."; color: Theme.text-faint; font-size: (9.5px * Theme.font-scale); wrap: word-wrap; }
                }

                GroupLabel { text: "SLEEP TIMER"; }
                ScrollView {
                    min-width: 0px;
                    width: 100%; height: 34px;
                    HorizontalLayout {
                        spacing: 7px;
                        for m in [0, 5, 10, 15, 30, 45, 60, 90] : Chip {
                            text: m == 0 ? "Off" : m + " min";
                            selected: App.sleep-minutes == m;
                            clicked => { App.set-sleep(m); }
                        }
                    }
                }
                if App.sleep-minutes > 0 : Text { text: "Stops playback in " + App.sleep-label; color: Theme.accent; font-size: (11px * Theme.font-scale); }

                Rectangle { height: 8px; }
            }
        }
    }
}
