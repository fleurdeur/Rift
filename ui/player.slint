import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Icon } from "icons.slint";
import { App } from "state.slint";
import { IconButton, ProgressSlider, Cover, TextButton, Chip } from "widgets.slint";

component VolumeSlider inherits Rectangle {
    in property <float> value: 0.8;
    height: 24px;
    horizontal-stretch: 1;
    background: transparent;
    Rectangle { width: 100%; height: 3px; border-radius: 2px; background: #ffffff28; y: (parent.height - self.height) / 2; }
    Rectangle { width: parent.width * value; height: 3px; border-radius: 2px; background: #ffffff; y: (parent.height - self.height) / 2; }
    Rectangle { x: Math.max(0, parent.width * value - 5px); y: (parent.height - 10px) / 2; width: 10px; height: 10px; border-radius: 5px; background: #ffffff; }
    TouchArea {
        width: 100%; height: 100%;
        clicked => { App.set-volume(Math.max(0, Math.min(1, self.mouse-x / self.width))); }
        moved => { if (self.pressed) { App.set-volume(Math.max(0, Math.min(1, self.mouse-x / self.width))); } }
    }
}

export component PlayerPage inherits Rectangle {
    width: 100%;
    height: 100%;
    property <bool> lyrics-mode: App.view == "lyrics";

    Rectangle {
        width: 100%; height: 100%;
        background: @linear-gradient(180deg, App.current.accent 0%, Theme.surface 42%, Theme.bg 78%);
    }
    Rectangle { x: -80px; y: -120px; width: 340px; height: 340px; border-radius: 170px; background: App.current.accent; opacity: 0.15; }

    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: 56px; background: transparent;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px; spacing: 4px;
                IconButton { icon: "chevron-down"; tint: Theme.text; box: 40px; clicked => { App.navigate("home"); } }
                VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 1px;
                    Text { text: root.lyrics-mode ? "LYRICS" : "PLAYING FROM"; color: #ffffffcc; font-size: (8.5px * Theme.font-scale); font-weight: 800; letter-spacing: 1.6px; horizontal-alignment: center; }
                    Text { text: App.current.source + " · " + App.current.album; color: #ffffff; font-size: (10.5px * Theme.font-scale); font-weight: 650; horizontal-alignment: center; overflow: elide; }
                }
                IconButton { icon: root.lyrics-mode ? "album" : "lyrics"; tint: Theme.text; active: root.lyrics-mode; box: 40px; clicked => { if (root.lyrics-mode) { App.navigate("now-playing"); } else { App.open-lyrics(); } } }
                IconButton { icon: "more-horizontal"; tint: Theme.text; box: 38px; clicked => { App.queue-add(App.current.id); } }
            }
        }

        if root.lyrics-mode == false : ScrollView {
            width: 100%; vertical-stretch: 1;
            VerticalLayout {
                padding-left: 20px; padding-right: 20px; padding-top: 6px; padding-bottom: 12px;
                spacing: 12px;

                Rectangle {
                    height: Math.min(parent.width - 40px, 360px);
                    border-radius: 8px;
                    background: #00000042;
                    clip: true;
                    Cover { width: 100%; height: 100%; art: App.current.art; accent: App.current.accent; radius: 8px; icon-size: 68px; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: 2px;
                        Text { text: App.current.title; color: Theme.text; font-size: (23px * Theme.font-scale); font-weight: 800; overflow: elide; }
                        HorizontalLayout { spacing: 6px;
                            Text { text: App.current.artist; color: Theme.text-sub; font-size: (13px * Theme.font-scale); overflow: elide; }
                            if App.current.source == "Local" : Text { text: "LOSSLESS"; color: Theme.accent; font-size: (8px * Theme.font-scale); font-weight: 800; vertical-alignment: center; }
                        }
                    }
                    IconButton {
                        icon: App.current-liked ? "heart" : "heart-outline";
                        tint: App.current-liked ? Theme.accent : Theme.text;
                        box: 42px; icon-size: 24px;
                        clicked => { App.toggle-like(App.current.id); }
                    }
                }

                VerticalLayout { spacing: 1px;
                    ProgressSlider { position: App.position; duration: App.duration; }
                    HorizontalLayout {
                        Text { text: App.position-label; color: #ffffffa8; font-size: (10px * Theme.font-scale); horizontal-stretch: 1; }
                        Text { text: App.duration-label; color: #ffffffa8; font-size: (10px * Theme.font-scale); }
                    }
                }

                if App.visualizer-on && App.spectrum.length > 0 : Rectangle {
                    height: 42px; background: transparent;
                    HorizontalLayout {
                        alignment: space-between;
                        for v in App.spectrum : Rectangle {
                            width: 3px; border-radius: 2px;
                            height: Math.max(3px, v * 40px);
                            background: #ffffffb8;
                            y: parent.height - self.height;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    padding-left: 4px; padding-right: 4px;
                    IconButton { icon: "shuffle"; tint: App.shuffle ? Theme.accent : #ffffffcc; clicked => { App.toggle-shuffle(); } }
                    IconButton { icon: "prev"; tint: Theme.text; icon-size: 30px; box: 48px; clicked => { App.previous-track(); } }
                    Rectangle {
                        width: 68px; height: 68px; border-radius: 34px;
                        background: #ffffff;
                        Icon { name: App.loading ? "timer" : (App.playing ? "pause" : "play"); tint: #000000; size: 32px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                        TouchArea { width: 100%; height: 100%; clicked => { App.toggle-play(); } }
                    }
                    IconButton { icon: "next"; tint: Theme.text; icon-size: 30px; box: 48px; clicked => { App.next-track(); } }
                    IconButton { icon: App.repeat == 2 ? "repeat-one" : "repeat"; tint: App.repeat > 0 ? Theme.accent : #ffffffcc; clicked => { App.cycle-repeat(); } }
                }

                HorizontalLayout {
                    alignment: space-around;
                    IconButton { icon: "lyrics"; tint: #ffffffcc; clicked => { App.open-lyrics(); } }
                    IconButton { icon: "eq"; tint: #ffffffcc; clicked => { App.navigate("eq"); } }
                    IconButton { icon: "visualizer"; tint: App.visualizer-on ? Theme.accent : #ffffffcc; clicked => { App.visualizer-on = !App.visualizer-on; App.save-settings(); } }
                    IconButton { icon: "timer"; tint: App.sleep-minutes > 0 ? Theme.accent : #ffffffcc; clicked => { App.navigate("sleep"); } }
                    IconButton { icon: "queue"; tint: #ffffffcc; clicked => { App.navigate("queue"); } }
                }

                HorizontalLayout {
                    spacing: 10px;
                    Icon { name: "volume"; tint: #ffffffa8; size: 17px; }
                    VolumeSlider { value: App.volume; }
                    Text { text: Math.round(App.volume * 100) + "%"; color: #ffffffa8; font-size: (10px * Theme.font-scale); width: 32px; horizontal-alignment: end; vertical-alignment: center; }
                }

                if App.sleep-minutes > 0 : Rectangle {
                    height: 32px; border-radius: 16px; background: #ffffff18;
                    HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 8px;
                        Icon { name: "timer"; tint: Theme.accent; size: 14px; }
                        Text { text: "Sleep timer · " + App.sleep-label; color: #ffffffcc; font-size: (10.5px * Theme.font-scale); horizontal-stretch: 1; vertical-alignment: center; }
                        Text { text: "Off"; color: Theme.accent; font-size: (10.5px * Theme.font-scale); font-weight: 700; vertical-alignment: center; }
                    }
                    TouchArea { width: 100%; height: 100%; clicked => { App.set-sleep(0); } }
                }

                Rectangle { height: 4px; }
            }
        }

        if root.lyrics-mode : VerticalLayout {
            padding-left: 20px; padding-right: 20px; padding-bottom: 18px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px; alignment: center;
                Text { text: App.current.title; color: Theme.text; font-size: (17px * Theme.font-scale); font-weight: 800; horizontal-stretch: 1; overflow: elide; }
                IconButton { icon: App.current-liked ? "heart" : "heart-outline"; tint: App.current-liked ? Theme.accent : Theme.text; icon-size: 20px; box: 34px; clicked => { App.toggle-like(App.current.id); } }
            }

            HorizontalLayout {
                spacing: 6px; alignment: center;
                Chip { text: "−0.5s"; clicked => { App.nudge-lyrics(-500); } }
                Chip { text: App.lyrics-source == "" ? "Lyrics" : App.lyrics-source; selected: true; clicked => { } }
                Chip { text: "+0.5s"; clicked => { App.nudge-lyrics(500); } }
                Text { text: App.lyrics.length + " lines"; color: Theme.text-faint; font-size: (10px * Theme.font-scale); horizontal-stretch: 1; horizontal-alignment: end; vertical-alignment: center; }
            }

            if App.lyrics.length == 0 : VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 10px;
                Icon { name: "lyrics"; tint: Theme.accent; size: 36px; }
                Text { text: "No synced lyrics"; color: Theme.text; font-size: (16px * Theme.font-scale); font-weight: 700; horizontal-alignment: center; }
                Text { text: "Rift tries your local .lrc file, LRCLIB, lyrics.ovh and NetEase in order."; color: Theme.text-sub; font-size: (11px * Theme.font-scale); horizontal-alignment: center; wrap: word-wrap; }
                TextButton { text: "Find lyrics"; primary: true; clicked => { App.load-lyrics(); } }
            }

            if App.lyrics.length > 0 : ScrollView {
                width: 100%; vertical-stretch: 1;
                VerticalLayout {
                    padding-top: 10px; padding-bottom: 30px;
                    spacing: 5px;
                    for line in App.lyrics : Rectangle {
                        height: Math.max(32px, line.active ? 54px : 38px);
                        background: transparent;
                        Text {
                            text: line.text;
                            color: line.active ? Theme.text : Theme.text-sub;
                            font-size: line.active ? (23px * Theme.font-scale) : (17px * Theme.font-scale);
                            font-weight: line.active ? 800 : 600;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            animate color { duration: 220ms; }
                            animate font-size { duration: 220ms; }
                        }
                        TouchArea { width: 100%; height: 100%; clicked => { App.seek-lyric(line.time); } }
                    }
                }
            }

            HorizontalLayout {
                alignment: space-between;
                Text { text: App.position-label; color: Theme.text-faint; font-size: (10px * Theme.font-scale); }
                IconButton { icon: App.playing ? "pause" : "play"; tint: Theme.text; clicked => { App.toggle-play(); } }
                Text { text: App.duration-label; color: Theme.text-faint; font-size: (10px * Theme.font-scale); }
            }
        }
    }
}
