import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Icon } from "icons.slint";
import { App } from "state.slint";
import { IconButton, SettingRow, ToggleSwitch, Chip, TextButton, Cover } from "widgets.slint";

component SectionCard inherits Rectangle {
    in property <string> title: "";
    width: 100%;
    min-width: 0px;
    background: Theme.surface;
    border-radius: 8px;
    VerticalLayout {
        min-width: 0px;
        padding: 12px;
        spacing: 8px;
        Text { text: root.title; color: Theme.text-sub; font-size: (11px * Theme.font-scale); font-weight: 700; letter-spacing: 0.6px; }
        @children
    }
}

component ImportTip inherits Rectangle {
    in property <string> title: "";
    in property <string> sub: "";
    height: 52px; border-radius: 8px; background: Theme.surface;
    HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 10px;
        Icon { name: "check"; tint: Theme.success; size: 17px; }
        VerticalLayout { horizontal-stretch: 1; spacing: 1px;
            Text { text: root.title; color: Theme.text; font-size: (12px * Theme.font-scale); font-weight: 700; }
            Text { text: root.sub; color: Theme.text-sub; font-size: (10px * Theme.font-scale); overflow: elide; }
        }
    }
}

export component SettingsPage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.bg;
    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: 60px; background: Theme.bg;
            HorizontalLayout {
                padding-left: 8px; padding-right: 16px; spacing: 6px;
                IconButton { icon: "back"; tint: Theme.text; clicked => { App.navigate("home"); } }
                Text { text: "Settings"; color: Theme.text; font-size: (25px * Theme.font-scale); font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                IconButton { icon: "sparkle"; tint: Theme.text; box: 38px; clicked => { App.refresh-home(); } }
            }
        }

        ScrollView {
            min-width: 0px;
            width: 100%; vertical-stretch: 1;
            VerticalLayout {
                padding-left: 16px; padding-right: 16px; padding-bottom: 22px;
                spacing: 14px;

                // Profile
                Rectangle {
                    height: 92px; border-radius: 8px; clip: true;
                    background: @linear-gradient(135deg, Theme.accent 0%, Theme.accent-2 55%, Theme.surface-2 100%);
                    HorizontalLayout {
                        padding: 14px; spacing: 12px;
                        Rectangle {
                            width: 62px; height: 62px; border-radius: 31px; background: #00000028;
                            Text { text: "R"; color: #ffffff; font-size: 27px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        VerticalLayout { horizontal-stretch: 1; spacing: 2px; alignment: center;
                            TextInput {
                                text: App.account-name;
                                color: #ffffff;
                                font-size: (20px * Theme.font-scale);
                                font-weight: 800;
                                single-line: true;
                                edited => { App.set-account-name(self.text); }
                            }
                            Text { text: App.account-sub; color: #ffffffcc; font-size: (11px * Theme.font-scale); }
                            Text { text: App.liked-count + " liked · " + App.playlists.length + " playlists · " + App.local-count + " local"; color: #ffffffa8; font-size: (10px * Theme.font-scale); }
                        }
                    }
                }

                // Equalizer shortcut with live spectrum.
                Rectangle {
                    height: 104px; border-radius: 8px; background: Theme.surface;
                    VerticalLayout {
                        padding: 12px; spacing: 6px;
                        HorizontalLayout {
                            spacing: 10px;
                            Rectangle { width: 34px; height: 34px; border-radius: 8px; background: Theme.surface-2;
                                Icon { name: "eq"; tint: Theme.accent; size: 19px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                            }
                            VerticalLayout { horizontal-stretch: 1; spacing: 1px; alignment: center;
                                Text { text: "Equalizer & visualizer"; color: Theme.text; font-size: (14px * Theme.font-scale); font-weight: 700; }
                                Text { text: "10-band EQ · compressor · limiter · profiles"; color: Theme.text-sub; font-size: (10.5px * Theme.font-scale); overflow: elide; }
                            }
                            Icon { name: "chevron-right"; tint: Theme.text-sub; size: 18px; }
                        }
                        Rectangle {
                            height: 34px; background: transparent;
                            HorizontalLayout {
                                alignment: space-between;
                                for i in 16 : Rectangle {
                                    width: 4px; border-radius: 2px;
                                    height: Math.max(3px, (App.spectrum.length > i ? App.spectrum[i] : 0.08) * 32px);
                                    background: Theme.accent;
                                    y: parent.height - self.height;
                                }
                            }
                        }
                    }
                    TouchArea { width: 100%; height: 100%; clicked => { App.navigate("eq"); } }
                }

                SectionCard { title: "APPEARANCE";
                    SettingRow {
                        title: "Theme";
                        subtitle: App.theme-list.length > 0 && App.theme-index < App.theme-list.length ? App.theme-list[App.theme-index].group + " · " + App.theme-list[App.theme-index].name : "Rift AMOLED";
                        icon: "palette";
                        clicked => { App.navigate("themes"); }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Icon { name: "moon"; tint: Theme.accent; size: 18px; }
                        Text { text: "AMOLED black"; color: Theme.text; font-size: (13px * Theme.font-scale); font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                        ToggleSwitch { checked: App.amoled; toggled(v) => { App.set-amoled(v); } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Icon { name: "sparkle"; tint: Theme.accent; size: 18px; }
                        Text { text: "Dynamic accent from artwork"; color: Theme.text; font-size: (13px * Theme.font-scale); font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                        ToggleSwitch { checked: App.dynamic-color; toggled(v) => { App.set-dynamic(v); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Text size"; color: Theme.text; font-size: (13px * Theme.font-scale); font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                        IconButton { icon: "minus"; tint: Theme.text-sub; icon-size: 13px; box: 28px; fill: Theme.surface-2; clicked => { App.set-font-scale(Math.max(0.85, App.font-scale - 0.05)); } }
                        Text { text: Math.round(App.font-scale * 100) + "%"; color: Theme.text-sub; font-size: (11px * Theme.font-scale); width: 38px; horizontal-alignment: center; vertical-alignment: center; }
                        Rectangle { width: 28px; height: 28px; border-radius: 14px; background: Theme.surface-2;
                            Icon { name: "add"; tint: Theme.text-sub; size: 13px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                            TouchArea { width: 100%; height: 100%; clicked => { App.set-font-scale(Math.min(1.35, App.font-scale + 0.05)); } }
                        }
                    }
                }

                SectionCard { title: "PLAYBACK";
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout { horizontal-stretch: 1; spacing: 1px; alignment: center;
                            Text { text: "Streaming quality"; color: Theme.text; font-size: (13px * Theme.font-scale); font-weight: 600; }
                            Text { text: App.audio-quality + " · lossless when available"; color: Theme.text-sub; font-size: (10.5px * Theme.font-scale); overflow: elide; }
                        }
                        for quality in ["Low", "High", "Best"] : Chip { text: quality; selected: App.audio-quality == quality; clicked => { App.set-quality(quality); } }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Icon { name: "volume"; tint: Theme.accent; size: 18px; }
                        VerticalLayout { horizontal-stretch: 1; spacing: 1px; alignment: center;
                            Text { text: "Volume normalizer"; color: Theme.text; font-size: (13px * Theme.font-scale); font-weight: 600; }
                            Text { text: "Even out quiet and loud tracks"; color: Theme.text-sub; font-size: (10.5px * Theme.font-scale); }
                        }
                        ToggleSwitch { checked: App.normalizer; toggled(v) => { App.toggle-normalizer(); } }
                    }
                    SettingRow { title: "Sleep timer"; subtitle: App.sleep-minutes > 0 ? App.sleep-label : "Off"; icon: "timer"; clicked => { App.navigate("sleep"); } }
                }

                SectionCard { title: "CONNECTED SERVICES";
                    SettingRow { title: "Spotify"; subtitle: App.spotify-status; icon: "sparkle"; clicked => { App.navigate("spotify"); } }
                }

                SectionCard { title: "LIBRARY & STORAGE";
                    SettingRow { title: "Scan local music"; subtitle: App.scan-busy ? "Scanning…" : "Music, Downloads and Rift folders"; icon: "folder"; clicked => { App.scan-library(); } }
                    Rectangle { height: 1px; background: Theme.line; }
                    SettingRow { title: "Import playlist"; subtitle: "YouTube, SoundCloud or Spotify link"; icon: "download"; clicked => { App.navigate("import"); } }
                    Rectangle { height: 1px; background: Theme.line; }
                    SettingRow { title: "Cached audio"; subtitle: App.cache-size + " used by Rift"; icon: "album"; clicked => { App.clear-cache(); } }
                    Rectangle { height: 1px; background: Theme.line; }
                    SettingRow { title: "Download quality"; subtitle: App.download-quality; icon: "download"; clicked => { App.download-quality = App.download-quality == "Best" ? "Data saver" : "Best"; App.save-settings(); } }
                }

                SectionCard { title: "ABOUT";
                    SettingRow { title: "Rift for Android"; subtitle: "Version 1.0.0 · native Rust"; icon: "sparkle"; clicked => { App.open-url("https://github.com/fleurdeur/Rift"); } }
                    Rectangle { height: 1px; background: Theme.line; }
                    SettingRow { title: "Source code"; subtitle: "github.com/fleurdeur/Rift"; icon: "person"; clicked => { App.open-url("https://github.com/fleurdeur/Rift"); } }
                    Rectangle { height: 1px; background: Theme.line; }
                    SettingRow { title: "Licenses"; subtitle: "MIT · Slint · Symphonia · Rodio"; icon: "library"; clicked => { App.toast-message("Open-source licenses are included in the repository"); } }
                }

                Text { text: "Made for humans. No ads. No tracking. Never."; color: Theme.text-faint; font-size: (10px * Theme.font-scale); horizontal-alignment: center; }
                Rectangle { height: 6px; }
            }
        }
    }
}

export component SpotifyPage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.bg;
    VerticalLayout {
        spacing: 0;
        Rectangle {
            height: 58px; background: Theme.bg;
            HorizontalLayout {
                padding-left: 8px; padding-right: 16px; spacing: 6px;
                IconButton { icon: "back"; tint: Theme.text; clicked => { App.navigate("settings"); } }
                Text { text: "Spotify"; color: Theme.text; font-size: (21px * Theme.font-scale); font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                Icon { name: "sparkle"; tint: Theme.accent; size: 20px; }
            }
        }
        ScrollView {
            min-width: 0px;
            width: 100%; vertical-stretch: 1;
            VerticalLayout {
                padding-left: 16px; padding-right: 16px; padding-bottom: 20px; spacing: 12px;
                Rectangle {
                    height: 104px; border-radius: 8px; clip: true;
                    background: @linear-gradient(135deg, Theme.accent 0%, Theme.accent-2 60%, Theme.surface-2 100%);
                    VerticalLayout { padding: 16px; spacing: 4px;
                        Icon { name: "sparkle"; tint: #000000; size: 24px; }
                        Text { text: App.spotify-connected ? "Spotify connected" : "Connect Spotify"; color: #000000; font-size: (20px * Theme.font-scale); font-weight: 800; }
                        Text { text: "Official Web API · catalogue + 30-second previews"; color: #000000cc; font-size: (10.5px * Theme.font-scale); }
                    }
                }
                Text { text: App.spotify-status; color: Theme.text-sub; font-size: (11px * Theme.font-scale); }
                Text { text: "Client ID"; color: Theme.text-sub; font-size: (10px * Theme.font-scale); }
                Rectangle {
                    height: 44px; border-radius: 6px; background: Theme.surface-2;
                    TextInput {
                        x: 12px; y: 0px; width: parent.width - 24px; height: 100%;
                        text: App.spotify-client-id;
                        color: Theme.text;
                        font-size: (12px * Theme.font-scale);
                        single-line: true;
                        edited => { App.set-spotify-client-id(self.text); }
                    }
                }
                Text { text: "Client Secret"; color: Theme.text-sub; font-size: (10px * Theme.font-scale); }
                Rectangle {
                    height: 44px; border-radius: 6px; background: Theme.surface-2;
                    TextInput {
                        x: 12px; y: 0px; width: parent.width - 24px; height: 100%;
                        text: App.spotify-client-secret;
                        color: Theme.text;
                        font-size: (12px * Theme.font-scale);
                        single-line: true;
                        edited => { App.set-spotify-client-secret(self.text); }
                    }
                }
                TextButton { text: App.spotify-connected ? "Reconnect" : "Connect"; primary: true; clicked => { App.connect-spotify(); } }
                Rectangle {
                    height: 150px; border-radius: 8px; background: Theme.surface;
                    VerticalLayout { padding: 14px; spacing: 6px;
                        Text { text: "How it works"; color: Theme.text; font-size: (13px * Theme.font-scale); font-weight: 700; }
                        Text { text: "Create an app at developer.spotify.com/dashboard, then paste its Client ID and Secret. Rift stores a short-lived token on this device."; color: Theme.text-sub; font-size: (10.5px * Theme.font-scale); wrap: word-wrap; }
                        Text { text: "Spotify does not allow third-party apps to stream full or lossless tracks. Rift uses a matching local FLAC automatically when you own one."; color: Theme.text-faint; font-size: (10px * Theme.font-scale); wrap: word-wrap; }
                    }
                }
                Rectangle { height: 8px; }
            }
        }
    }
}

export component ImportPage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.bg;
    VerticalLayout {
        spacing: 0;
        Rectangle {
            height: 56px; background: transparent;
            HorizontalLayout {
                padding-left: 10px; padding-right: 16px; spacing: 8px; 
                IconButton { icon: "back"; tint: Theme.text; clicked => { App.go-back(); } }
                Text { text: "Import playlist"; color: Theme.text; font-size: (18px * Theme.font-scale); font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
            }
        }
        ScrollView {
            min-width: 0px;
            width: 100%; vertical-stretch: 1;
            VerticalLayout {
                padding-left: 18px; padding-right: 18px; padding-bottom: 20px; spacing: 14px;

                Rectangle {
                    height: 150px; border-radius: 22px; clip: true;
                    background: @linear-gradient(145deg, Theme.accent 0%, #1c1727 100%);
                    VerticalLayout { padding: 18px; spacing: 6px; 
                        Icon { name: "download"; tint: #ffffff; size: 30px; }
                        Text { text: "Bring your playlists"; color: #ffffff; font-size: (20px * Theme.font-scale); font-weight: 800; }
                        Text { text: "Paste a public link and Rift will find the tracks."; color: #ffffffb8; font-size: (11px * Theme.font-scale);  }
                    }
                }

                Text { text: "SOURCE"; color: Theme.text-faint; font-size: (9.5px * Theme.font-scale); font-weight: 800; letter-spacing: 1.5px; }
                ScrollView {
                    min-width: 0px;
                    width: 100%; height: 32px;
                    HorizontalLayout {
                        spacing: 8px;
                        for s in App.import-sources : Chip { text: s; selected: App.import-source == s; clicked => { App.set-import-source(s); } }
                    }
                }

                Text { text: "PLAYLIST LINK"; color: Theme.text-faint; font-size: (9.5px * Theme.font-scale); font-weight: 800; letter-spacing: 1.5px; }
                Rectangle {
                    height: 52px; border-radius: 14px; background: Theme.surface; border-width: 1px; border-color: Theme.line;
                    HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 8px; 
                        Icon { name: "library"; tint: Theme.text-faint; size: 18px; }
                        TextInput {
                            text: App.import-url;
                            color: Theme.text;
                            font-size: (12px * Theme.font-scale);
                            single-line: true;
                            horizontal-stretch: 1;
                            edited => { App.set-import-url(self.text); }
                            accepted => { App.import-playlist(); }
                        }
                    }
                }

                Text { text: App.import-status; visible: App.import-status != ""; color: Theme.accent; font-size: (11px * Theme.font-scale); wrap: word-wrap; }
                if App.import-busy : Rectangle {
                    height: 6px; border-radius: 3px; background: Theme.surface-3;
                    Rectangle { width: parent.width * (App.import-progress / 100); height: 6px; border-radius: 3px; background: Theme.accent; }
                }

                TextButton { text: App.import-busy ? "Importing…" : "Import playlist"; primary: true; clicked => { App.import-playlist(); } }

                VerticalLayout { spacing: 8px;
                    Text { text: "SUPPORTED"; color: Theme.text-faint; font-size: (9.5px * Theme.font-scale); font-weight: 800; letter-spacing: 1.5px; }
                    ImportTip { title: "YouTube"; sub: "Public playlist or mix links, including music.youtube.com"; }
                    ImportTip { title: "SoundCloud"; sub: "Public sets and user playlists"; }
                    ImportTip { title: "Spotify"; sub: "Public playlist links (resolved by title search)"; }
                }
                Rectangle { height: 6px; }
            }
        }
    }
}

export component SleepPage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.bg;
    VerticalLayout {
        spacing: 0;
        Rectangle {
            height: 56px; background: transparent;
            HorizontalLayout { padding-left: 10px; padding-right: 16px; spacing: 8px; 
                IconButton { icon: "back"; tint: Theme.text; clicked => { App.go-back(); } }
                Text { text: "Sleep timer"; color: Theme.text; font-size: (18px * Theme.font-scale); font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
            }
        }
        VerticalLayout {
            padding: 24px; spacing: 18px; alignment: center;
            Rectangle { width: 120px; height: 120px; border-radius: 60px; background: @linear-gradient(135deg, Theme.accent 0%, #1c1727 100%);
                Icon { name: "timer"; tint: #ffffff; size: 52px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            }
            Text { text: App.sleep-minutes > 0 ? "Stopping in " + App.sleep-label : "Sleep timer is off"; color: Theme.text; font-size: (20px * Theme.font-scale); font-weight: 800;  }
            Text { text: "Playback fades out and pauses automatically when the timer ends."; color: Theme.text-sub; font-size: (12px * Theme.font-scale);  wrap: word-wrap; }
            GridLayout {
                spacing: 10px;
                for m in [0, 5, 10, 15, 30, 45, 60, 90] : Rectangle {
                    height: 52px; border-radius: 16px;
                    background: App.sleep-minutes == m ? Theme.accent : Theme.surface;
                    Text { text: m == 0 ? "Off" : m + " min"; color: App.sleep-minutes == m ? #ffffff : Theme.text; font-size: (13px * Theme.font-scale); font-weight: 700;  vertical-alignment: center; }
                    TouchArea { width: 100%; height: 100%; clicked => { App.set-sleep(m); } }
                }
            }
            if App.sleep-minutes > 0 : TextButton { text: "Cancel timer"; clicked => { App.set-sleep(0); } }
        }
    }
}
