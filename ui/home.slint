import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Icon } from "icons.slint";
import { App } from "state.slint";
import { SectionTitle, TrackCard, TrackRow, QuickCard, QuickTile, Chip, IconButton } from "widgets.slint";

export component HomePage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.bg;

    VerticalLayout {
        spacing: 0;

        // Spotify-style top row: avatar, filter pills, settings shortcut.
        Rectangle {
            height: 62px;
            background: Theme.bg;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 12px;
                spacing: 10px;
                Rectangle {
                    width: 34px; height: 34px; border-radius: 17px;
                    background: @linear-gradient(135deg, Theme.accent 0%, Theme.accent-2 100%);
                    Text { text: "R"; color: #000000; font-size: 16px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { width: 100%; height: 100%; clicked => { App.navigate("settings"); } }
                }
                ScrollView {
                    horizontal-stretch: 1;
                    height: 32px;
                    HorizontalLayout {
                        spacing: 8px;
                        Chip { text: "Music"; selected: true; clicked => { } }
                        Chip { text: "Local files"; clicked => { App.navigate("local"); } }
                        Chip { text: "History"; clicked => { App.navigate("history"); } }
                    }
                }
                IconButton { icon: "settings"; tint: Theme.text; box: 38px; icon-size: 20px; clicked => { App.navigate("settings"); } }
            }
        }

        ScrollView {
            min-width: 0px;
            width: 100%;
            vertical-stretch: 1;
            VerticalLayout {
                min-width: 0px;
                width: 100%;
                padding-left: 16px;
                padding-right: 16px;
                padding-bottom: 20px;
                spacing: 18px;

                Text { text: "Good listening"; color: Theme.text; font-size: (25px * Theme.font-scale); font-weight: 800; }

                // Shortcut grid, like Spotify's recents.
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        QuickTile { target: "liked"; icon: "heart"; title: "Liked songs"; sub: App.liked-count + " tracks"; accent: Theme.accent; }
                        QuickTile { target: "local"; icon: "folder"; title: "Local files"; sub: App.local-count + " tracks"; accent: Theme.accent-2; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        QuickTile { target: "history"; icon: "history"; title: "History"; sub: App.history.length + " recently"; accent: Theme.accent; }
                        QuickTile { target: "queue"; icon: "queue"; title: "Queue"; sub: App.queue.length + " up next"; accent: Theme.accent-2; }
                    }
                }

                if App.home-made.length > 0 : VerticalLayout {
                    spacing: 8px;
                    SectionTitle { title: "Made for you"; action: "Refresh"; show-action: false; }
                    ScrollView {
                        min-width: 0px;
                        height: 216px;
                        width: 100%;
                        HorizontalLayout {
                            min-width: 0px;
                            spacing: 12px;
                            padding-right: 16px;
                            for t in App.home-made : TrackCard { item: t; }
                        }
                    }
                }

                if App.home-recent.length > 0 : VerticalLayout {
                    spacing: 8px;
                    SectionTitle { title: "Recently played"; action: "History"; show-action: true; }
                    ScrollView {
                        min-width: 0px;
                        height: 216px;
                        width: 100%;
                        HorizontalLayout {
                            min-width: 0px;
                            spacing: 12px;
                            padding-right: 16px;
                            for t in App.home-recent : TrackCard { item: t; }
                        }
                    }
                }

                if App.home-trending.length > 0 : VerticalLayout {
                    spacing: 2px;
                    SectionTitle { title: "Trending now"; action: "Search"; show-action: true; }
                    for t in App.home-trending : TrackRow { item: t; }
                }

                if App.home-quick.length > 0 : VerticalLayout {
                    spacing: 8px;
                    SectionTitle { title: "Quick picks"; action: "Shuffle"; show-action: true; }
                    GridLayout {
                        spacing: 8px;
                        for t in App.home-quick : QuickCard { item: t; }
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    SectionTitle { title: "Browse all"; action: ""; show-action: false; }
                    ScrollView {
                        min-width: 0px;
                        width: 100%; height: 32px;
                        HorizontalLayout {
                            spacing: 8px;
                            for g in App.genres : Chip { text: g; clicked => { App.navigate("search"); App.search(g); } }
                        }
                    }
                }

                if App.loading-home : VerticalLayout {
                    height: 72px;
                    alignment: center;
                    spacing: 8px;
                    Text { text: "Finding something good…"; color: Theme.text-sub; font-size: (12px * Theme.font-scale); horizontal-alignment: center; }
                }

                if App.home-recent.length == 0 && App.home-trending.length == 0 && !App.loading-home : VerticalLayout {
                    spacing: 8px;
                    Text { text: "Your home is quiet"; color: Theme.text; font-size: (16px * Theme.font-scale); font-weight: 700; }
                    Text { text: "Search for music, scan local files, or connect Spotify in Settings."; color: Theme.text-sub; font-size: (12px * Theme.font-scale); wrap: word-wrap; }
                }

                Rectangle { height: 8px; }
            }
        }
    }
}
