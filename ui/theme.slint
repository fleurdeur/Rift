// Rift for Android — design tokens. Values are applied from the selected
// Spicetify palette at runtime by the Rust theme manager.
export global Theme {
    in-out property <bool> light: false;
    in-out property <bool> amoled: true;
    in-out property <bool> dynamic: true;
    in-out property <float> font-scale: 1.0;

    in-out property <color> accent: #1ed760;
    in-out property <color> accent-2: #1db954;
    in-out property <color> bg: #000000;
    in-out property <color> bg-elevated: #0a0a0a;
    in-out property <color> surface: #101010;
    in-out property <color> surface-2: #181818;
    in-out property <color> surface-3: #242424;
    in-out property <color> line: #282828;
    in-out property <color> text: #ffffff;
    in-out property <color> text-sub: #b3b3b3;
    in-out property <color> text-faint: #7a7a7a;
    in-out property <color> nav: #000000;
    in-out property <color> danger: #ff4d6d;
    in-out property <color> success: #1ed760;

    in-out property <brush> accent-grad: @linear-gradient(135deg, accent 0%, accent-2 100%);
    in-out property <brush> hero-grad: @linear-gradient(150deg, accent 0%, surface 58%, bg 100%);
    in-out property <brush> glass: @linear-gradient(160deg, #ffffff16 0%, #ffffff04 100%);
}
