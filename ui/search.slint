import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Icon } from "icons.slint";
import { App } from "state.slint";
import { Chip, TrackRow, Cover, SectionTitle, IconButton } from "widgets.slint";

export component SearchPage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.bg;
    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: 60px;
            background: Theme.bg;
            HorizontalLayout {
                padding-left: 16px; padding-right: 16px;
                Text { text: "Search"; color: Theme.text; font-size: (25px * Theme.font-scale); font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                IconButton { icon: "settings"; tint: Theme.text; box: 38px; icon-size: 20px; clicked => { App.navigate("settings"); } }
            }
        }

        HorizontalLayout {
            padding-left: 16px; padding-right: 16px;
            Rectangle {
                height: 46px;
                border-radius: 6px;
                background: Theme.surface-2;
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding-left: 14px; padding-right: 6px;
                    spacing: 9px;
                    Icon { name: "search"; tint: Theme.text-sub; size: 20px; }
                    Rectangle {
                        horizontal-stretch: 1;
                        TextInput {
                            x: 0; width: 100%; height: 100%;
                            text: App.search-query;
                            color: Theme.text;
                            font-size: (14px * Theme.font-scale);
                            single-line: true;
                            edited => { App.search-query = self.text; }
                            accepted => { App.search(self.text); }
                        }
                        Text {
                            x: 0; y: (parent.height - self.height) / 2;
                            visible: App.search-query == "";
                            text: "Songs, artists, albums";
                            color: Theme.text-faint;
                            font-size: (13px * Theme.font-scale);
                        }
                    }
                    Rectangle {
                        visible: App.search-query != "";
                        width: 28px; height: 28px; border-radius: 14px; background: Theme.surface-3;
                        Icon { name: "close"; tint: Theme.text-sub; size: 14px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                        TouchArea { width: 100%; height: 100%; clicked => { App.search-query = ""; } }
                    }
                }
            }
        }

        Rectangle { height: 10px; }

        ScrollView {
            min-width: 0px;
            width: 100%;
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 16px; padding-right: 16px; padding-bottom: 20px;
                spacing: 16px;

                if App.search-query == "" : VerticalLayout {
                    spacing: 14px;

                    if App.search-history.length > 0 : VerticalLayout {
                        spacing: 8px;
                        SectionTitle { title: "Recent searches"; action: "Clear"; show-action: false; }
                        ScrollView {
                            min-width: 0px;
                            width: 100%; height: 32px;
                            HorizontalLayout {
                                spacing: 8px;
                                for h in App.search-history : Chip { text: h; clicked => { App.search(h); } }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 10px;
                        SectionTitle { title: "Browse all"; action: ""; show-action: false; }
                        for row in 4 : HorizontalLayout {
                            spacing: 10px;
                            for col in 2 : Rectangle {
                                property <int> idx: row * 2 + col;
                                visible: idx < App.genres.length;
                                height: 88px; border-radius: 8px; clip: true;
                                horizontal-stretch: 1;
                                property <color> tile-color: [#1ed760, #0ea5a0, #f59e0b, #8b5cf6, #ec4899, #ef4444, #3b82f6, #14b8a6][idx];
                                background: tile-color;
                                Rectangle {
                                    x: parent.width - 34px; y: parent.height - 32px;
                                    width: 82px; height: 82px; border-radius: 6px;
                                    background: #00000033;
                                }
                                Text {
                                    text: idx < App.genres.length ? App.genres[idx] : "";
                                    color: #000000; font-size: (16px * Theme.font-scale); font-weight: 800;
                                    x: 12px; y: 12px; width: parent.width - 54px;
                                }
                                TouchArea { width: 100%; height: 100%; clicked => { if (idx < App.genres.length) { App.navigate("search"); App.search(App.genres[idx]); } } }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        SectionTitle { title: "Your playlists"; action: ""; show-action: false; }
                        if App.playlists.length == 0 : Rectangle {
                            height: 74px; border-radius: 8px; background: Theme.surface-2;
                            HorizontalLayout {
                                padding: 10px; spacing: 12px;
                                Rectangle { width: 52px; height: 52px; border-radius: 6px; background: Theme.surface-3;
                                    Icon { name: "add"; tint: Theme.accent; size: 23px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                }
                                VerticalLayout { horizontal-stretch: 1; spacing: 2px; alignment: center;
                                    Text { text: "Create your first playlist"; color: Theme.text; font-size: (14px * Theme.font-scale); font-weight: 700; }
                                    Text { text: "It's easy, we'll help you"; color: Theme.text-sub; font-size: (11px * Theme.font-scale); }
                                }
                                Icon { name: "chevron-right"; tint: Theme.text-sub; size: 18px; }
                            }
                            TouchArea { width: 100%; height: 100%; clicked => { App.create-playlist(); } }
                        }
                        for p in App.playlists : Rectangle {
                            height: 64px; border-radius: 8px; background: Theme.surface-2;
                            HorizontalLayout {
                                padding: 8px; spacing: 11px;
                                Cover { art: p.art; accent: p.accent; width: 48px; height: 48px; radius: 4px; icon-size: 18px; }
                                VerticalLayout { horizontal-stretch: 1; spacing: 1px; alignment: center;
                                    Text { text: p.name; color: Theme.text; font-size: (13.5px * Theme.font-scale); font-weight: 650; overflow: elide; }
                                    Text { text: p.subtitle; color: Theme.text-sub; font-size: (11px * Theme.font-scale); overflow: elide; }
                                }
                                Icon { name: "play"; tint: Theme.accent; size: 18px; }
                            }
                            TouchArea { width: 100%; height: 100%; clicked => { App.open-playlist(p.id); } }
                        }
                    }
                }

                if App.search-query != "" : VerticalLayout {
                    spacing: 12px;
                    ScrollView {
                        min-width: 0px;
                        width: 100%; height: 32px;
                        HorizontalLayout {
                            spacing: 8px;
                            for s in ["All", "Spotify", "YouTube", "SoundCloud"] : Chip {
                                text: s;
                                selected: App.search-source == s;
                                clicked => { App.set-search-source(s); App.search(App.search-query); }
                            }
                        }
                    }

                    if App.search-loading : VerticalLayout {
                        height: 110px; alignment: center; spacing: 10px;
                        Text { text: "Searching…"; color: Theme.text; font-size: (15px * Theme.font-scale); font-weight: 700; horizontal-alignment: center; }
                        Text { text: "Checking Spotify, YouTube and SoundCloud"; color: Theme.text-sub; font-size: (11px * Theme.font-scale); horizontal-alignment: center; }
                    }

                    if !App.search-loading && App.search-results.length == 0 : VerticalLayout {
                        height: 120px; alignment: center; spacing: 6px;
                        Text { text: "No results found"; color: Theme.text; font-size: (16px * Theme.font-scale); font-weight: 700; horizontal-alignment: center; }
                        Text { text: "Please make sure your words are spelled correctly, or use fewer or different keywords."; color: Theme.text-sub; font-size: (11px * Theme.font-scale); horizontal-alignment: center; wrap: word-wrap; }
                    }

                    if App.search-results.length > 0 : VerticalLayout {
                        spacing: 6px;
                        Text { text: "Top result"; color: Theme.text; font-size: (18px * Theme.font-scale); font-weight: 800; }
                        Rectangle {
                            height: 92px; border-radius: 8px; background: Theme.surface-2;
                            HorizontalLayout {
                                padding: 10px; spacing: 12px;
                                Cover { art: App.search-results[0].art; accent: App.search-results[0].accent; width: 72px; height: 72px; radius: 6px; icon-size: 26px; }
                                VerticalLayout { horizontal-stretch: 1; spacing: 3px; alignment: center;
                                    Text { text: App.search-results[0].title; color: Theme.text; font-size: (18px * Theme.font-scale); font-weight: 800; overflow: elide; }
                                    Text { text: App.search-results[0].artist; color: Theme.text-sub; font-size: (12px * Theme.font-scale); overflow: elide; }
                                }
                            }
                            TouchArea { width: 100%; height: 100%; clicked => { App.play-id(App.search-results[0].id); } }
                        }
                    }

                    if App.search-results.length > 0 : VerticalLayout {
                        spacing: 2px;
                        SectionTitle { title: "Songs"; action: ""; show-action: false; }
                        for t in App.search-results : TrackRow { item: t; }
                    }
                }

                Rectangle { height: 8px; }
            }
        }
    }
}
