import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { Icon } from "icons.slint";
import { App } from "state.slint";
import { Chip, TrackRow, Cover, EmptyState, SectionTitle } from "widgets.slint";

export component SearchPage inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;
    VerticalLayout {
        spacing: 0;

        Rectangle {
            height: 68px;
            background: transparent;
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px;
                spacing: 8px;
                Text { text: "Search"; color: Theme.text; font-size: (27px * Theme.font-scale); font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                Icon { name: "sparkle"; tint: Theme.accent; size: 21px; }
            }
        }

        // Search field
        HorizontalLayout {
            padding-left: 20px; padding-right: 20px;
            Rectangle {
                height: 50px;
                border-radius: 25px;
                background: Theme.surface;
                border-width: 1px; border-color: Theme.line;
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 6px;
                    spacing: 9px;
                    Icon { name: "search"; tint: Theme.text-faint; size: 20px; }
                    Rectangle {
                        horizontal-stretch: 1;
                        TextInput {
                            x: 0; width: 100%; height: 100%;
                            text: App.search-query;
                            color: Theme.text;
                            font-size: (14px * Theme.font-scale);
                            single-line: true;
                            edited => { App.search-query = self.text; }
                            accepted => { App.search(self.text); }
                        }
                        Text {
                            x: 0; y: (parent.height - self.height) / 2;
                            visible: App.search-query == "";
                            text: "What do you want to listen to?";
                            color: Theme.text-faint;
                            font-size: (13px * Theme.font-scale);
                        }
                    }
                    Rectangle {
                        visible: App.search-query != "";
                        width: 30px; height: 30px; border-radius: 15px; background: Theme.surface-2;
                        Icon { name: "close"; tint: Theme.text-sub; size: 15px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                        TouchArea { width: 100%; height: 100%; clicked => { App.search-query = ""; } }
                    }
                    Rectangle {
                        width: 38px; height: 38px; border-radius: 19px;
                        background: Theme.accent;
                        Icon { name: "search"; tint: #ffffff; size: 19px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                        TouchArea { width: 100%; height: 100%; clicked => { App.search(App.search-query); } }
                    }
                }
            }
        }

        Rectangle { height: 12px; }

        ScrollView {
            min-width: 0px;
            width: 100%;
            vertical-stretch: 1;
            VerticalLayout {
                padding-left: 20px; padding-right: 20px; padding-bottom: 24px;
                spacing: 16px;

                if App.search-query == "" : VerticalLayout {
                    spacing: 14px;

                    if App.search-history.length > 0 : VerticalLayout {
                        spacing: 8px;
                        SectionTitle { title: "Recent searches"; action: ""; show-action: false; }
                        ScrollView {
                            min-width: 0px;
                            width: 100%; height: 32px;
                            HorizontalLayout {
                                spacing: 8px;
                                for h in App.search-history : Chip { text: h; clicked => { App.search(h); } }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 10px;
                        SectionTitle { title: "Browse"; action: ""; show-action: false; }
                        for row in 4 : HorizontalLayout {
                            spacing: 10px;
                            for col in 2 : Rectangle {
                                property <int> idx: row * 2 + col;
                                visible: idx < App.genres.length;
                                height: 78px; border-radius: 18px; clip: true;
                                horizontal-stretch: 1;
                                property <color> tile-color: [#1ed760, #0ea5a0, #f59e0b, #8b5cf6, #ec4899, #ef4444, #3b82f6, #14b8a6][idx];
                                background: @linear-gradient(140deg, tile-color 0%, #0b0f0d 120%);
                                Rectangle { x: parent.width - 34px; y: parent.height - 30px; width: 82px; height: 82px; border-radius: 41px; background: #ffffff12; }
                                Text { text: idx < App.genres.length ? App.genres[idx] : ""; color: #ffffff; font-size: (14px * Theme.font-scale); font-weight: 750; x: 16px; y: 16px; width: parent.width - 32px; }
                                TouchArea { width: 100%; height: 100%; clicked => { if (idx < App.genres.length) { App.search(App.genres[idx]); } } }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        SectionTitle { title: "Your top mixes"; action: ""; show-action: false; }
                        if App.playlists.length == 0 : Rectangle {
                            height: 142px; border-radius: 18px; background: Theme.surface;
                            VerticalLayout {
                                padding: 18px; spacing: 7px; alignment: center;
                                Rectangle { width: 44px; height: 44px; border-radius: 22px; background: Theme.surface-2;
                                    Icon { name: "album"; tint: Theme.accent; size: 23px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                }
                                Text { text: "No mixes yet"; color: Theme.text; font-size: (15px * Theme.font-scale); font-weight: 750; horizontal-alignment: center; }
                                Text { text: "Like tracks or import a playlist to build your collection."; color: Theme.text-sub; font-size: (11px * Theme.font-scale); horizontal-alignment: center; wrap: word-wrap; }
                            }
                        }
                        for p in App.playlists : Rectangle {
                            height: 62px; border-radius: 14px; background: Theme.surface;
                            HorizontalLayout {
                                padding: 8px; spacing: 10px;
                                Cover { art: p.art; accent: p.accent; width: 46px; height: 46px; radius: 10px; icon-size: 18px; }
                                VerticalLayout { horizontal-stretch: 1; spacing: 1px;
                                    Text { text: p.name; color: Theme.text; font-size: (13px * Theme.font-scale); font-weight: 700; overflow: elide; }
                                    Text { text: p.subtitle; color: Theme.text-sub; font-size: (11px * Theme.font-scale); overflow: elide; }
                                }
                                Icon { name: "play"; tint: Theme.accent; size: 18px; }
                            }
                            TouchArea { width: 100%; height: 100%; clicked => { App.open-playlist(p.id); } }
                        }
                    }
                }

                if App.search-query != "" : VerticalLayout {
                    spacing: 12px;
                    ScrollView {
                        min-width: 0px;
                        width: 100%; height: 32px;
                        HorizontalLayout {
                            spacing: 8px;
                            for s in ["All", "Spotify", "YouTube", "SoundCloud"] : Chip {
                                text: s;
                                selected: App.search-source == s;
                                clicked => { App.set-search-source(s); App.search(App.search-query); }
                            }
                        }
                    }

                    if App.search-loading : VerticalLayout {
                        height: 120px; alignment: center; spacing: 10px;
                        Icon { name: "search"; tint: Theme.accent; size: 28px; }
                        Text { text: "Searching the airwaves…"; color: Theme.text-sub; font-size: (12px * Theme.font-scale); }
                    }

                    if !App.search-loading && App.search-results.length == 0 : EmptyState {
                        icon: "search";
                        title: "No results";
                        subtitle: "Try another title, artist, or vibe.";
                    }

                    if App.search-results.length > 0 : VerticalLayout {
                        spacing: 2px;
                        SectionTitle { title: "Top results"; action: ""; show-action: false; }
                        for t in App.search-results : TrackRow { item: t; }
                    }
                }

                Rectangle { height: 10px; }
            }
        }
    }
}
