import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { App, TrackItem } from "state.slint";

export component IconButton inherits Rectangle {
    in property <string> icon: "play";
    in property <length> icon-size: 22px;
    in property <color> tint: Theme.text;
    in property <color> fill: transparent;
    in property <length> box: 42px;
    in property <bool> active: false;
    width: box; height: box;
    border-radius: box / 2;
    background: active ? Theme.accent : fill;
    animate background { duration: 160ms; }
    Icon { name: root.icon; tint: root.active ? #ffffff : root.tint; size: root.icon-size; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
    TouchArea { width: 100%; height: 100%; clicked => { root.clicked(); } }
    callback clicked();
}

export component TextButton inherits Rectangle {
    in property <string> text: "Button";
    in property <bool> primary: false;
    in property <bool> compact: false;
    in property <color> tint: primary ? #000000 : Theme.text;
    height: compact ? 34px : 44px;
    min-width: compact ? 66px : 112px;
    border-radius: self.height / 2;
    background: primary ? Theme.accent : Theme.surface-2;
    border-width: primary ? 0px : 1px;
    border-color: Theme.line;
    horizontal-stretch: 0;
    animate background { duration: 180ms; }
    HorizontalLayout {
        alignment: center;
        padding-left: compact ? 16px : 22px;
        padding-right: compact ? 16px : 22px;
        Text {
            text: root.text;
            color: root.tint;
            font-size: ((compact ? 12px : 13px) * Theme.font-scale);
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    TouchArea { width: 100%; height: 100%; clicked => { root.clicked(); } }
    callback clicked();
}

export component Chip inherits Rectangle {
    in property <string> text: "Chip";
    in property <bool> selected: false;
    height: 32px;
    min-width: 48px;
    border-radius: 16px;
    background: selected ? Theme.accent : Theme.surface-2;
    border-width: selected ? 0px : 1px;
    border-color: Theme.line;
    animate background { duration: 180ms; }
    HorizontalLayout {
        alignment: center;
        padding-left: 14px;
        padding-right: 14px;
        Text {
            text: root.text;
            color: selected ? #000000 : Theme.text-sub;
            font-size: (12px * Theme.font-scale);
            font-weight: 650;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    TouchArea { width: 100%; height: 100%; clicked => { root.clicked(); } }
    callback clicked();
}

export component SectionTitle inherits HorizontalLayout {
    in property <string> title: "Section";
    in property <string> action: "See all";
    in property <bool> show-action: true;
    height: 34px;
    alignment: space-between;
    Text { text: root.title; color: Theme.text; font-size: (21px * Theme.font-scale); font-weight: 800; vertical-alignment: center; }
    Text { text: root.action; visible: root.show-action; color: Theme.text-sub; font-size: (11px * Theme.font-scale); font-weight: 700; vertical-alignment: center; }
}

export component Cover inherits Rectangle {
    in property <image> art;
    in property <color> accent: Theme.accent;
    in property <length> radius: 6px;
    in property <length> icon-size: 24px;
    clip: true;
    border-radius: radius;
    background: @linear-gradient(135deg, accent 0%, #171717 100%);
    Image { source: root.art; width: 100%; height: 100%; image-fit: cover; }
    Icon { visible: root.art.width == 0; name: "music"; tint: #ffffffb8; size: root.icon-size; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
}

export component PlayBadge inherits Rectangle {
    in property <bool> playing: false;
    width: 38px; height: 38px; border-radius: 19px;
    background: Theme.accent;
    animate width { duration: 160ms; }
    Icon { name: root.playing ? "pause" : "play"; tint: #000000; size: 20px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
}

export component TrackRow inherits Rectangle {
    in property <TrackItem> item;
    in property <bool> show-art: true;
    in property <bool> show-index: false;
    in property <int> index: 0;
    in property <bool> highlight: false;
    width: 100%;
    min-width: 0px;
    height: 64px;
    border-radius: 8px;
    background: highlight ? Theme.surface-2 : transparent;
    animate background { duration: 140ms; }
    HorizontalLayout {
        padding-left: 4px; padding-right: 4px;
        spacing: 12px;
        min-width: 0px;
        if root.show-index : Text { text: root.index + 1; color: Theme.text-faint; font-size: (12px * Theme.font-scale); width: 20px; vertical-alignment: center; }
        if root.show-art : Cover { art: root.item.art; accent: root.item.accent; width: 48px; height: 48px; radius: 5px; icon-size: 20px; }
        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;
            min-width: 0px;
            Text { text: root.item.title; color: root.highlight ? Theme.accent : Theme.text; font-size: (14px * Theme.font-scale); font-weight: 600; overflow: elide; min-width: 0px; width: 100%; }
            Text { text: root.item.artist; color: Theme.text-sub; font-size: (11.5px * Theme.font-scale); overflow: elide; min-width: 0px; width: 100%; }
        }
        IconButton {
            icon: root.item.liked ? "heart" : "heart-outline";
            tint: root.item.liked ? Theme.accent : Theme.text-sub;
            icon-size: 19px; box: 34px;
            clicked => { App.toggle-like(root.item.id); }
        }
        IconButton {
            icon: "more-horizontal"; tint: Theme.text-sub; icon-size: 19px; box: 32px;
            clicked => { App.queue-add(root.item.id); }
        }
    }
    TouchArea {
        width: 100%; height: 100%;
        clicked => { App.play-id(root.item.id); }
    }
}

export component TrackCard inherits Rectangle {
    in property <TrackItem> item;
    in property <length> card-width: 148px;
    width: card-width;
    height: card-width + 62px;
    background: transparent;
    VerticalLayout {
        spacing: 7px;
        Cover { art: root.item.art; accent: root.item.accent; width: root.card-width; height: root.card-width; radius: 7px; icon-size: 32px; }
        Text { text: root.item.title; color: Theme.text; font-size: (13px * Theme.font-scale); font-weight: 650; overflow: elide; min-width: 0px; width: 100%; }
        Text { text: root.item.artist; color: Theme.text-sub; font-size: (11px * Theme.font-scale); overflow: elide; min-width: 0px; width: 100%; }
    }
    TouchArea { width: 100%; height: 100%; clicked => { App.play-id(root.item.id); } }
}

export component QuickCard inherits Rectangle {
    in property <TrackItem> item;
    height: 56px;
    min-width: 0px;
    border-radius: 6px;
    background: Theme.surface-2;
    clip: true;
    HorizontalLayout {
        spacing: 10px;
        Cover { art: root.item.art; accent: root.item.accent; width: 56px; height: 56px; radius: 0px; icon-size: 18px; }
        Text { text: root.item.title; color: Theme.text; font-size: (12.5px * Theme.font-scale); font-weight: 700; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
        Icon { name: "play"; tint: Theme.accent; size: 16px; }
        Rectangle { width: 8px; }
    }
    TouchArea { width: 100%; height: 100%; clicked => { App.play-id(root.item.id); } }
}

export component QuickTile inherits Rectangle {
    in property <string> target: "liked";
    in property <string> icon: "heart";
    in property <string> title: "Liked songs";
    in property <string> sub: "0 tracks";
    in property <color> accent: Theme.accent;
    height: 68px;
    border-radius: 8px;
    background: Theme.surface-2;
    horizontal-stretch: 1;
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px;
        spacing: 10px;
        Rectangle {

            width: 48px; height: 48px; border-radius: 6px; background: root.accent;
            Icon { name: root.icon; tint: #000000; size: 23px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
        VerticalLayout {
            horizontal-stretch: 1; spacing: 1px; alignment: center;
            Text { text: root.title; color: Theme.text; font-size: (12.5px * Theme.font-scale); font-weight: 700; overflow: elide; }
            Text { text: root.sub; color: Theme.text-sub; font-size: (10.5px * Theme.font-scale); overflow: elide; }
        }
    }
    TouchArea { width: 100%; height: 100%; clicked => { if (root.target == "queue") { App.navigate("queue"); } else { App.navigate(root.target); } } }
}

export component VerticalFader inherits Rectangle {
    in property <float> value: 0;
    in property <int> index: 0;
    width: 24px;
    height: 148px;
    background: transparent;
    Rectangle {
        width: 4px; height: 112px; border-radius: 2px;
        background: Theme.surface-3;
        x: (parent.width - self.width) / 2;
        y: 14px;
    }
    Rectangle {
        width: 4px; height: 56px; border-radius: 2px;
        background: Theme.accent;
        x: (parent.width - self.width) / 2;
        y: 14px + (1 - (root.value + 12) / 24) * 56px;
    }
    Rectangle {
        width: 14px; height: 14px; border-radius: 7px;
        background: #ffffff;
        x: (parent.width - self.width) / 2;
        y: 7px + (1 - (root.value + 12) / 24) * 112px;
        animate y { duration: 80ms; }
    }
    TouchArea {
        width: 100%; height: 100%;
        moved => {
            App.set-eq(root.index, Math.max(-12.0, Math.min(12.0, 12.0 - ((self.mouse-y - 7px) / 1px) / 112.0 * 24.0)));
        }
        clicked => {
            App.set-eq(root.index, Math.max(-12.0, Math.min(12.0, 12.0 - ((self.mouse-y - 7px) / 1px) / 112.0 * 24.0)));
        }
    }
}

export component ProgressSlider inherits Rectangle {
    in property <int> position: 0;
    in property <int> duration: 1;
    in property <bool> enabled: true;
    height: 22px;
    background: transparent;
    property <float> frac: Math.max(0, Math.min(1, position / Math.max(1, duration)));
    Rectangle { width: 100%; height: 3px; border-radius: 2px; background: Theme.surface-3; y: (parent.height - self.height) / 2; }
    Rectangle { width: parent.width * frac; height: 3px; border-radius: 2px; background: Theme.accent; y: (parent.height - self.height) / 2; }
    Rectangle { x: Math.max(0, parent.width * frac - 5px); y: (parent.height - 10px) / 2; width: 10px; height: 10px; border-radius: 5px; background: #ffffff; visible: root.enabled; }
    TouchArea {
        width: 100%; height: 100%;
        enabled: root.enabled;
        clicked => { if (root.duration > 0) { App.seek(Math.round(self.mouse-x / self.width * root.duration)); } }
        moved => { if (self.pressed && root.duration > 0) { App.seek(Math.round(self.mouse-x / self.width * root.duration)); } }
    }
}

export component MiniPlayer inherits Rectangle {
    height: 58px;
    background: Theme.surface;
    border-radius: 6px;
    clip: true;
    property <float> progress: App.duration > 0 ? Math.min(1, App.position / App.duration) : 0;
    Rectangle { width: parent.width * progress; height: 2px; background: Theme.accent; y: parent.height - self.height; }
    HorizontalLayout {
        padding-left: 7px; padding-right: 6px;
        spacing: 10px;
        Cover { art: App.current.art; accent: App.current.accent; width: 44px; height: 44px; radius: 4px; icon-size: 17px; }
        VerticalLayout {
            horizontal-stretch: 1; spacing: 0px;
            Text { text: App.current.title; color: Theme.text; font-size: (13px * Theme.font-scale); font-weight: 650; overflow: elide; }
            Text { text: App.loading ? "Loading…" : App.current.artist; color: App.loading ? Theme.accent : Theme.text-sub; font-size: (11px * Theme.font-scale); overflow: elide; }
        }
        IconButton { icon: App.loading ? "timer" : (App.playing ? "pause" : "play"); tint: Theme.text; icon-size: 20px; box: 36px; clicked => { App.toggle-play(); } }
        IconButton { icon: "next"; tint: Theme.text; icon-size: 20px; box: 34px; clicked => { App.next-track(); } }
    }
    TouchArea { width: 100%; height: 100%; clicked => { App.navigate("now-playing"); } }
}

export component BottomNav inherits Rectangle {
    height: 62px;
    background: Theme.nav;
    HorizontalLayout {
        alignment: space-around;
        padding-left: 24px; padding-right: 24px; padding-top: 7px; padding-bottom: 5px;
        for tab in [{ id: "home", icon: "home", label: "Home" }, { id: "search", icon: "search", label: "Search" }, { id: "library", icon: "library", label: "Your Library" }] : nav-item := Rectangle {
            width: 92px; height: 48px; background: transparent;
            property <bool> active: App.view == tab.id || (tab.id == "library" && (App.view == "liked" || App.view == "local" || App.view == "albums" || App.view == "history" || App.view == "playlist" || App.view == "album" || App.view == "artist" || App.view == "queue" || App.view == "settings" || App.view == "themes"));
            VerticalLayout {
                alignment: center; spacing: 2px;
                Rectangle {
                    width: 30px; height: 26px; background: transparent;
                    Icon { name: tab.icon; tint: nav-item.active ? Theme.text : Theme.text-faint; size: 23px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                }
                Text { text: tab.label; width: 100%; color: nav-item.active ? Theme.text : Theme.text-faint; font-size: (9.5px * Theme.font-scale); font-weight: nav-item.active ? 700 : 600; horizontal-alignment: center; }
            }
            TouchArea { width: 100%; height: 100%; clicked => { App.navigate(tab.id); } }
        }
    }
}

export component EmptyState inherits VerticalLayout {
    in property <string> icon: "lyrics";
    in property <string> title: "Nothing here yet";
    in property <string> subtitle: "";
    spacing: 8px;
    alignment: center;
    padding: 28px;
    Icon { name: root.icon; tint: Theme.text-faint; size: 38px; }
    Text { text: root.title; color: Theme.text; font-size: (16px * Theme.font-scale); font-weight: 700; horizontal-alignment: center; }
    Text { text: root.subtitle; color: Theme.text-sub; font-size: (12px * Theme.font-scale); horizontal-alignment: center; wrap: word-wrap; }
}

export component EmptyCard inherits Rectangle {
    in property <string> icon: "album";
    in property <string> title: "Nothing here yet";
    in property <string> subtitle: "";
    height: 136px;
    border-radius: 8px;
    background: Theme.surface-2;
    VerticalLayout {
        padding: 18px;
        spacing: 7px;
        alignment: center;
        Rectangle {
            width: 42px; height: 42px; border-radius: 21px; background: Theme.surface-3;
            Icon { name: root.icon; tint: Theme.accent; size: 22px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
        Text { text: root.title; color: Theme.text; font-size: (15px * Theme.font-scale); font-weight: 700; horizontal-alignment: center; }
        Text { text: root.subtitle; color: Theme.text-sub; font-size: (11px * Theme.font-scale); horizontal-alignment: center; wrap: word-wrap; }
    }
}

export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked: false;
    width: 44px; height: 24px; border-radius: 12px;
    background: checked ? Theme.accent : Theme.surface-3;
    animate background { duration: 180ms; }
    Rectangle { width: 18px; height: 18px; border-radius: 9px; background: #ffffff; y: 3px; x: checked ? 23px : 3px; animate x { duration: 180ms; } }
    TouchArea { width: 100%; height: 100%; clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
    callback toggled(bool);
}

export component SettingRow inherits Rectangle {
    in property <string> title: "Setting";
    in property <string> subtitle: "";
    in property <string> icon: "settings";
    in property <bool> danger: false;
    height: subtitle == "" ? 56px : 68px;
    background: transparent;
    HorizontalLayout {
        spacing: 12px; padding-left: 2px; padding-right: 2px;
        Rectangle {
            width: 34px; height: 34px; border-radius: 8px; background: Theme.surface-2;
            Icon { name: root.icon; tint: root.danger ? Theme.danger : Theme.accent; size: 18px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
        VerticalLayout { horizontal-stretch: 1; spacing: 2px; alignment: center;
            Text { text: root.title; color: root.danger ? Theme.danger : Theme.text; font-size: (13.5px * Theme.font-scale); font-weight: 600; overflow: elide; vertical-alignment: center; }
            Text { text: root.subtitle; visible: root.subtitle != ""; color: Theme.text-sub; font-size: (10.5px * Theme.font-scale); overflow: elide; vertical-alignment: center; }
        }
        Icon { name: "chevron-right"; tint: Theme.text-faint; size: 17px; }
    }
    TouchArea { width: 100%; height: 100%; clicked => { root.clicked(); } }
    callback clicked();
}
